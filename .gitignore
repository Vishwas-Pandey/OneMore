# macOS
.DS_Store

# ===== Unity generated / cache =====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
sysinfo.txt
*.stackdump
crashlytics-build.properties
*.apk.meta

# Never keep two copies of import settings caches
[Aa]uto[Gg]enerated/

# Visual Studio / Rider / VSCode metadata
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
